<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="referrer" content="no-referrer">
  <title>Primary SBA Revision — Locked</title>
  <style>
    :root{color-scheme:light;--ink:#13253a;--muted:#607086;--line:#dbe4ec;--paper:#fff;--wash:#f4f8fa;--teal:#087f7a;--teal-dark:#07645f;--danger:#b42318;--shadow:0 20px 58px rgba(24,52,73,.14);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    *{box-sizing:border-box}html{min-height:100%;background:var(--wash)}body{min-height:100vh;min-height:100dvh;margin:0;color:var(--ink);background:radial-gradient(circle at 50% 0%,rgba(8,127,122,.12),transparent 31rem),linear-gradient(180deg,#fbfdfd,var(--wash));display:grid;place-items:center;padding:max(20px,env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) max(20px,env(safe-area-inset-bottom)) max(14px,env(safe-area-inset-left))}
    button,input{font:inherit}.shell{width:min(100%,460px)}.brand{display:flex;justify-content:center;align-items:center;gap:10px;margin-bottom:18px;font-weight:800;text-align:left;overflow-wrap:anywhere}.mark{display:grid;width:38px;height:38px;flex:0 0 38px;place-items:center;border-radius:12px;color:#fff;background:linear-gradient(145deg,#0c9992,#07645f);box-shadow:0 9px 19px rgba(8,127,122,.2);overflow:hidden}.mark svg{width:21px;height:21px}.mark .diamond-mark{font-size:1.2rem;line-height:1}.mark.custom{position:relative;padding:3px;color:var(--teal-dark);border:1px solid var(--line);background:#fff}.mark.custom img{display:block;width:100%;height:100%;object-fit:contain;border-radius:8px}.mark.custom .logo-fallback{display:none;width:100%;height:100%;place-items:center;font-size:1rem}.card{overflow:hidden;border:1px solid rgba(205,218,229,.95);border-radius:22px;background:rgba(255,255,255,.97);box-shadow:var(--shadow)}.head{padding:30px 28px 23px;border-bottom:1px solid var(--line);background:linear-gradient(135deg,rgba(231,245,243,.85),#fff 75%)}.eyebrow{margin:0 0 7px;color:var(--teal-dark);font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}h1{margin:0;font-size:clamp(1.45rem,7vw,2rem);line-height:1.12;letter-spacing:-.025em}.intro{margin:10px 0 0;color:var(--muted);font-size:.9rem;line-height:1.55}.body{padding:25px 28px 29px}.card.compact .head{padding-bottom:21px}.card.compact .body{padding-top:21px}.file{margin:0 0 20px;padding:11px 12px;border:1px solid var(--line);border-radius:11px;background:#f8fbfc;color:var(--muted);font-size:.77rem;overflow-wrap:anywhere}.file strong{display:block;margin-bottom:2px;color:var(--ink);font-size:.82rem}label[for=password]{display:block;margin-bottom:7px;font-size:.84rem;font-weight:750}input[type=password],input[type=text]{width:100%;min-height:50px;padding:10px 13px;border:1px solid #bdcbd7;border-radius:12px;color:var(--ink);background:#fff;outline:none}input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,127,122,.13)}.row{display:flex;justify-content:space-between;gap:12px;margin-top:11px;color:var(--muted);font-size:.75rem}.show{display:inline-flex;align-items:center;gap:7px;cursor:pointer;color:var(--ink)}.show input{width:18px;height:18px;accent-color:var(--teal)}button{width:100%;min-height:50px;margin-top:20px;border:0;border-radius:12px;color:#fff;background:var(--teal);cursor:pointer;font-weight:800;touch-action:manipulation}button:hover{background:var(--teal-dark)}button:disabled{cursor:wait;opacity:.62}.status{min-height:20px;margin:13px 0 0;color:var(--muted);font-size:.8rem;line-height:1.45}.status.error{color:var(--danger)}.privacy{margin:17px 0 0;padding-top:15px;border-top:1px solid var(--line);color:var(--muted);font-size:.72rem;line-height:1.5;text-align:center}@media(max-width:480px){.card{border-radius:18px}.head{padding:25px 21px 20px}.body{padding:21px}.card.compact .head{padding-bottom:18px}.card.compact .body{padding-top:18px}.row{align-items:flex-start;flex-direction:column-reverse}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
  </style>
</head>
<body>
  <main class="shell">
    <div class="brand"><span class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="M9.5 12.5 11 14l3.5-4"></path></svg></span><span>Anaesthesiology and Critical Care</span></div>
    <section class="card compact" aria-labelledby="unlock-title">
      <header class="head"><p class="eyebrow">Password protected</p><h1 id="unlock-title">Primary SBA Revision</h1><p class="intro">Enter the password to decrypt and open this file on your device.</p></header>
      <div class="body">
        
        <form id="unlock-form">
          <label for="password">Password</label>
          <input id="password" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" required autofocus>
          <div class="row"><span>No password recovery is available.</span><label class="show"><input id="show-password" type="checkbox"> Show password</label></div>
          <button id="unlock-button" type="submit">Unlock file</button>
          <p class="status" id="unlock-status" role="status" aria-live="polite"></p>
        </form>
        <p class="privacy">Decryption happens locally in this browser. The password is not stored or transmitted.</p>
      </div>
    </section>
  </main>
  <script id="locked-payload" type="application/json">{"format":"local-html-encryptor-v2","version":2,"kdf":{"name":"PBKDF2","hash":"SHA-256","iterations":600000,"salt":"htzpG971dvchgs/mQNA2Xw=="},"cipher":{"name":"AES-GCM","length":256,"iv":"qxYeaSF4cWt15NU8"},"original":{"name":"Primary_Revision_SBA_Question_Bank_DEPLOY_READY_v5_2_2.html","size":14021265,"sha256":"4cc3bef5f01fe8fb71806f4d3a237c242c76b2fda73061429dd96aa3135bbee0"},"ciphertext":""}</script>
  <script>
  (function () {
    "use strict";
    var payloadElement = document.getElementById("locked-payload");
    var form = document.getElementById("unlock-form");
    var passwordInput = document.getElementById("password");
    var showPassword = document.getElementById("show-password");
    var button = document.getElementById("unlock-button");
    var status = document.getElementById("unlock-status");
    var fileName = document.getElementById("locked-file-name");
    var customLogo = document.querySelector(".mark.custom img");
    var payload;

    if (customLogo) customLogo.addEventListener("error", function () {
      customLogo.style.display = "none";
      var fallback = customLogo.nextElementSibling;
      if (fallback) fallback.style.display = "grid";
    });

    function base64ToBytes(value) {
      var binary = atob(value);
      var bytes = new Uint8Array(binary.length);
      for (var index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
      return bytes;
    }

    function bytesToHex(bytes) {
      var result = "";
      for (var index = 0; index < bytes.length; index += 1) result += bytes[index].toString(16).padStart(2, "0");
      return result;
    }

    async function sha256Hex(bytes) {
      return bytesToHex(new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)));
    }

    async function deriveKey(password, salt) {
      var material = await crypto.subtle.importKey("raw", new TextEncoder().encode(password), "PBKDF2", false, ["deriveKey"]);
      return crypto.subtle.deriveKey(
        { name: "PBKDF2", salt: salt, iterations: payload.kdf.iterations, hash: "SHA-256" },
        material,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
    }

    function collectScripts(parsed) {
      var descriptors = [];
      var scripts = Array.from(parsed.querySelectorAll("script"));
      scripts.forEach(function (script, index) {
        var marker = parsed.createElement("template");
        marker.setAttribute("data-unlock-script", String(index));
        descriptors.push({
          attributes: Array.from(script.attributes).map(function (attribute) { return [attribute.name, attribute.value]; }),
          text: script.textContent || ""
        });
        script.replaceWith(marker);
      });
      return descriptors;
    }

    async function restoreScripts(descriptors) {
      for (var index = 0; index < descriptors.length; index += 1) {
        var descriptor = descriptors[index];
        var marker = document.querySelector('template[data-unlock-script="' + index + '"]');
        if (!marker) continue;
        var script = document.createElement("script");
        descriptor.attributes.forEach(function (attribute) { script.setAttribute(attribute[0], attribute[1]); });
        script.textContent = descriptor.text;
        var waitsForLoad = script.hasAttribute("src") || script.getAttribute("type") === "module";
        var completion = waitsForLoad ? new Promise(function (resolve) {
          script.addEventListener("load", resolve, { once: true });
          script.addEventListener("error", resolve, { once: true });
        }) : Promise.resolve();
        marker.replaceWith(script);
        await completion;
      }
    }

    async function activateHtml(html) {
      var parsed = new DOMParser().parseFromString(html, "text/html");
      var descriptors = collectScripts(parsed);
      var imported = document.importNode(parsed.documentElement, true);
      document.replaceChild(imported, document.documentElement);
      await restoreScripts(descriptors);
      document.dispatchEvent(new Event("DOMContentLoaded", { bubbles: true }));
      window.dispatchEvent(new Event("load"));
    }

    function fail(message) {
      status.textContent = message;
      status.className = "status error";
      button.disabled = false;
      passwordInput.disabled = false;
      passwordInput.focus();
      passwordInput.select();
    }

    try {
      payload = JSON.parse(payloadElement.textContent);
      if (fileName) fileName.textContent = payload.original.name;
    } catch (error) {
      fail("This encrypted file is damaged or incomplete.");
      return;
    }

    if (!window.crypto || !window.crypto.subtle) {
      fail("Secure browser encryption is unavailable. Open this file in a current browser or from HTTPS/localhost.");
      button.disabled = true;
      return;
    }

    showPassword.addEventListener("change", function () {
      passwordInput.type = showPassword.checked ? "text" : "password";
    });

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      if (!passwordInput.value) return;
      button.disabled = true;
      passwordInput.disabled = true;
      status.className = "status";
      status.textContent = "Deriving the key and decrypting…";
      var salt;
      var iv;
      var encrypted;
      var plain;
      try {
        salt = base64ToBytes(payload.kdf.salt);
        iv = base64ToBytes(payload.cipher.iv);
        encrypted = base64ToBytes(payload.ciphertext);
        var key = await deriveKey(passwordInput.value, salt);
        plain = new Uint8Array(await crypto.subtle.decrypt({ name: "AES-GCM", iv: iv }, key, encrypted));
        var hash = await sha256Hex(plain);
        if (plain.byteLength !== payload.original.size || hash !== payload.original.sha256) throw new Error("Integrity check failed");
        status.textContent = "Verified. Opening protected website…";
        var html = new TextDecoder("utf-8", { fatal: true }).decode(plain);
        passwordInput.value = "";
        salt.fill(0);
        iv.fill(0);
        encrypted.fill(0);
        plain.fill(0);
        await activateHtml(html);
      } catch (error) {
        if (salt) salt.fill(0);
        if (iv) iv.fill(0);
        if (encrypted) encrypted.fill(0);
        if (plain) plain.fill(0);
        fail("Incorrect password or damaged file.");
      }
    });
  }());
  </script>
</body>
</html>